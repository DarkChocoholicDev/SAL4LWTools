/*
 *  Sample that reverses a user-specified text string.
 */

#include <SALLib.salinc>;
.entry Main;
.org $2000;

char Greeting[] = "SAMPLE: REVERSE-TEXT\r  REVERSES A USER-PROVIDED\r  TEXT STRING.";
char InputPrompt[] = "\rENTER TEXT TO REVERSE\r: ";
char OutputMarkerStart[] = "==> ";
char OutputMarkerEnd[] = " <==";
char ExitMsg[] = "BYE!";
InputBufferHeader BufHeader;
char Buffer[128];

export void Main()
{
    BufHeader.MaxLength = d = 128;
    Console.WriteLine(x --> Greeting);

    repeat
    {
        // Display the input prompt.
        Console.WriteString(x --> InputPrompt);

        // Wait for a line of input (or Break).
        Console.ReadLine(x --> BufHeader);
        b = a;
        Console.WriteChar(a = Char.CR);

        // Exit if Break was pressed.
        if (b != Key.Enter)
        {
            break;
        }

        // If at least one character was entered...
        if (cc.notzero(y = BufHeader.CurrentLength))
        {
            // Write the text in the form: "==> <reversed-text> <=="
            Console.WriteString(x --> OutputMarkerStart);

            x --> Buffer[y];
            do
            {
                Console.WriteChar(a = [--x]);
            } while (cc.notzero(y--));

            Console.WriteLine(x --> OutputMarkerEnd);
        }
    } until (break);

    Console.WriteLine(x --> ExitMsg);
}
